@using Microsoft.AspNetCore.Components.Authorization
@using Client.Services

@inject NavigationManager Navigation
@inject AuthApiService AuthService

<MudAppBar Color="Color.Primary" Dense="true" Elevation="0">

    <AuthorizeView Context="authState">

        <Authorized>
            <div class="d-flex align-center w-100">

                <MudText Typo="Typo.h6" Class="mr-6 text-nowrap">
                    Advatruck TMS
                </MudText>

                <div class="d-flex align-center ga-2 w-100">

                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/">
                        Dashboard
                    </MudButton>

                    @if (authState.User.IsInRole("Dispatcher") || authState.User.IsInRole("Admin"))
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/loads">
                            Loads
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/auctions">
                        Auctions
                    </MudButton>

                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/bids">
                        Bids
                    </MudButton>

                    <MudSpacer />

                    <MudText Typo="Typo.body2" Class="mr-4" Style="opacity: 0.85;">
                        @authState.User.Identity?.Name
                    </MudText>

                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="Logout">
                        Logout
                    </MudButton>

                </div>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="d-flex align-center w-100">
                <MudText Typo="Typo.h6">Advatruck TMS</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/login">
                    Login
                </MudButton>
            </div>
        </NotAuthorized>

    </AuthorizeView>

</MudAppBar>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}