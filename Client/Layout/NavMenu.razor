@using Microsoft.AspNetCore.Components.Authorization
@using Client.Services
@using System.Security.Claims

@inject NavigationManager Navigation
@inject AuthApiService AuthService

<MudAppBar Color="Color.Primary" Dense="true" Elevation="0">

    <AuthorizeView Context="authState">

        <Authorized>
            <div class="d-flex align-center w-100">

                <MudText Typo="Typo.h6" Class="mr-6 text-nowrap" Style="font-weight: 800; cursor: pointer" @onclick="@(() => Navigation.NavigateTo("/"))">
                    Advatruck TMS
                </MudText>

                <div class="d-flex align-center ga-2 w-100">

                    @if (authState.User.IsInRole("Dispatcher") || authState.User.IsInRole("Admin"))
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/loads">
                            Loads
                        </MudButton>
                        
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/drivers">
                            Drivers
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/auctions">
                        Auctions
                    </MudButton>
                    
                    @if (authState.User.IsInRole("Admin"))
                    {
                        <MudButton Variant="Variant.Text" 
                                   Color="Color.Inherit" 
                                   Href="/admin/users"
                                   StartIcon="@Icons.Material.Filled.AdminPanelSettings">
                            Users
                        </MudButton>
                    }

                    <MudSpacer />

                    @* Використовуємо OnClick замість Href для розумного переходу *@
                    <MudButton Variant="Variant.Text" 
                               Color="Color.Inherit" 
                               Class="mr-2"
                               StartIcon="@Icons.Material.Filled.Person"
                               OnClick="@(() => NavigateToProfile(authState.User))">
                        @authState.User.Identity?.Name
                    </MudButton>

                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Inherit" 
                               Size="Size.Small"
                               OnClick="Logout">
                        Logout
                    </MudButton>

                </div>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="d-flex align-center w-100">
                <MudText Typo="Typo.h6" Style="font-weight: 800;">Advatruck TMS</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/login">
                    Login
                </MudButton>
            </div>
        </NotAuthorized>

    </AuthorizeView>

</MudAppBar>

@code {
    private void NavigateToProfile(ClaimsPrincipal user)
    {
        // Для всіх інших ролей
        Navigation.NavigateTo("/profile");
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}