@using Core.Models
@using Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuctionLotApiService AuctionService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(IsEditMode ? "Edit Auction" : "Create Auction")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField T="Guid"
                                  Label="Load ID"
                                  @bind-Value="_model.LoadId"
                                  Required="true"
                                  RequiredError="Load ID is required"
                                  Converter="_guidConverter" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Start Date"
                                   @bind-Date="_startDate"
                                   Required="true"
                                   MinDate="DateTime.Today" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Start Time"
                                   @bind-Time="_startTime"
                                   Required="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="End Date"
                                   @bind-Date="_endDate"
                                   Required="true"
                                   MinDate="_startDate" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="End Time"
                                   @bind-Time="_endTime"
                                   Required="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Note (optional)"
                                  @bind-Value="_model.Note"
                                  Lines="3"
                                  MaxLength="500" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SubmitAsync"
                   Disabled="@_submitting">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsEditMode ? "Save Changes" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public AuctionLotDto? ExistingLot { get; set; }

    private bool IsEditMode => ExistingLot is not null;
    private MudForm _form = null!;
    private bool _isValid;
    private bool _submitting;

    private AuctionLotCreateUpdateDto _model = new();

    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;

    private IConverter<Guid, string?> _guidConverter = Conversions.From(
        (Guid g) => g == Guid.Empty ? string.Empty : g.ToString(),
        s => Guid.TryParse(s, out var g) ? g : Guid.Empty
    );

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode && ExistingLot is not null)
        {
            _model.Id = ExistingLot.Id;
            _model.LoadId = ExistingLot.LoadId;
            _model.DispatcherCreatedId = ExistingLot.DispatcherCreatedId;
            _model.Note = ExistingLot.Note;

            var localStart = ExistingLot.StartsAt.ToLocalTime();
            _startDate = localStart.Date;
            _startTime = localStart.TimeOfDay;

            var localEnd = ExistingLot.EndsAt.ToLocalTime();
            _endDate = localEnd.Date;
            _endTime = localEnd.TimeOfDay;
        }
        else
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst(c =>
                c.Type == "sub" ||
                c.Type == "nameid" ||
                c.Type == System.Security.Claims.ClaimTypes.NameIdentifier);

            if (userIdClaim is not null && Guid.TryParse(userIdClaim.Value, out var uid))
                _model.DispatcherCreatedId = uid;

            _startDate = DateTime.Today;
            _startTime = DateTime.Now.TimeOfDay;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        if (_startDate == null || _startTime == null || _endDate == null || _endTime == null)
        {
            Snackbar.Add("Please select both date and time", Severity.Warning);
            return;
        }

        var finalStartsAt = _startDate.Value.Add(_startTime.Value);
        var finalEndsAt = _endDate.Value.Add(_endTime.Value);

        if (finalEndsAt <= finalStartsAt)
        {
            Snackbar.Add("End time must be after start time", Severity.Warning);
            return;
        }

        _model.StartsAt = finalStartsAt.ToUniversalTime();
        _model.EndsAt = finalEndsAt.ToUniversalTime();

        _submitting = true;
        try
        {
            if (IsEditMode)
            {
                var updated = await AuctionService.UpdateAsync(_model);
                if (updated is not null)
                {
                    Snackbar.Add("Auction updated successfully", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(updated));
                }
            }
            else
            {
                var id = await AuctionService.CreateAsync(_model);
                if (id is not null)
                {
                    Snackbar.Add("Auction created successfully", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(id));
                }
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Communication error with server", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}