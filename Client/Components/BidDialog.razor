@using Core.Models
@using Client.Services
@inject BidApiService BidService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-2" />
            Place or Update Your Bid
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudNumericField @bind-Value="_bidRate" 
                             Label="Your Rate" 
                             HideSpinButtons="true"
                             Variant="Variant.Outlined" 
                             Adornment="Adornment.Start" 
                             AdornmentText="₴" 
                             AdornmentColor="Color.Success"
                             Format="F2"
                             Required="true"
                             T="decimal" />

            <MudTextField @bind-Value="_note" 
                          Label="Note (Optional)" 
                          Variant="Variant.Outlined" 
                          Lines="3"
                          Class="mt-4"
                          Placeholder="e.g., Own truck, ready to load today, contact me via phone" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="SubmitBid" 
                   Disabled="_processing">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing...</MudText>
            }
            else
            {
                <MudText>Confirm Bid</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] 
    public Guid AuctionLotId { get; set; }
    
    [Parameter] 
    public decimal? InitialRate { get; set; }
    
    [Parameter] 
    public string? InitialNote { get; set; }

    private MudForm _form = null!;
    private decimal _bidRate;
    private string? _note;
    private bool _processing;

    protected override void OnInitialized()
    {
        if (InitialRate.HasValue)
        {
            _bidRate = InitialRate.Value;
        }
        _note = InitialNote;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitBid()
    {
        if (_bidRate <= 0)
        {
            Snackbar.Add("Rate must be greater than zero", Severity.Warning);
            return;
        }

        _processing = true;
    
        var dto = new BidCreateUpdateDto 
        { 
            AuctionLotId = AuctionLotId, 
            Rate = _bidRate,
            Note = _note 
        };

        try 
        {
            var id = await BidService.PlaceAsync(dto); 
            
            Snackbar.Add("Bid submitted successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }
}