@using Core.Models
@using Core.Enums
@using Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject LoadApiService LoadsService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(IsEditMode ? "Edit Load" : "Create Load")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_model.Rate" Label="Rate (₴)" Format="F2" Min="0.01M" Required="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_model.CargoWeight" Label="Weight (kg)" Min="0.1" Required="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="LoadStatus" Label="Status" @bind-Value="_model.LoadStatus" Variant="Variant.Outlined">
                        <MudSelectItem Value="LoadStatus.Scheduled">Scheduled</MudSelectItem>
                        <MudSelectItem Value="LoadStatus.Ongoing">Ongoing</MudSelectItem>
                        <MudSelectItem Value="LoadStatus.Completed">Completed</MudSelectItem>
                        <MudSelectItem Value="LoadStatus.Cancelled">Cancelled</MudSelectItem>
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="4">
                    <MudNumericField @bind-Value="_model.CargoLength" Label="Length (cm)" Min="1" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="_model.CargoWidth" Label="Width (cm)" Min="1" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="_model.CargoHeight" Label="Height (cm)" Min="1" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Note" Label="General Note" Lines="2" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle1">Route Stops (@_model.LoadStops.Count)</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.AddLocation" 
                                   Size="Size.Small" 
                                   Variant="Variant.Filled" 
                                   Color="Color.Primary"
                                   OnClick="AddStop">Add Stop</MudButton>
                    </div>
                    
                    @for (int i = 0; i < _model.LoadStops.Count; i++)
                    {
                        var index = i;
                        var stop = _model.LoadStops.ElementAt(index);

                        <MudPaper Class="pa-4 mb-4" Elevation="2">
                            <div class="d-flex align-center mb-2">
                                <MudText Typo="Typo.button" Class="mr-4">#@(index + 1)</MudText>
                                <MudSelect T="LoadLocationType" Label="Type" @bind-Value="stop.LoadLocationType" Dense="true" Margin="Margin.Dense">
                                    <MudSelectItem Value="LoadLocationType.Pickup">Pickup</MudSelectItem>
                                    <MudSelectItem Value="LoadLocationType.Delivery">Delivery</MudSelectItem>
                                </MudSelect>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Color="Color.Error" 
                                               Size="Size.Small" 
                                               OnClick="@(() => RemoveStop(index))" 
                                               Disabled="@(_model.LoadStops.Count <= 2)" />
                            </div>
                            
                            <MudTextField @bind-Value="stop.Address" Label="Address" Required="true" Class="mb-2" />
                            
                            @* ОСЬ ЦЕ ПОЛЕ ТРЕБА БУЛО ДОДАТИ *@
                            <MudTextField @bind-Value="stop.Note" Label="Stop Note (Gate code, contact person, etc.)" Class="mb-2" />
                            
                            <div class="d-flex ga-4">
                                <MudDatePicker Label="Date" @bind-Date="@_stopDates[index]" Required="true" Editable="true" />
                                <MudTimePicker Label="Time" @bind-Time="@_stopTimes[index]" Required="true" Editable="true" />
                            </div>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@_submitting">
            @if (_submitting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            @(IsEditMode ? "Save Changes" : "Create Load")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public LoadDto? ExistingLoad { get; set; }

    private bool IsEditMode => ExistingLoad is not null;
    private MudForm _form = null!;
    private bool _isValid;
    private bool _submitting;

    private readonly LoadCreateUpdateDto _model = new() { LoadStops = new List<LoadStopDto>() };
    
    private readonly List<DateTime?> _stopDates = new();
    private readonly List<TimeSpan?> _stopTimes = new();

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode && ExistingLoad is not null)
        {
            _model.Id = ExistingLoad.Id;
            _model.Note = ExistingLoad.Note;
            _model.Rate = ExistingLoad.Rate;
            _model.CargoWeight = ExistingLoad.CargoWeight;
            _model.CargoWidth = ExistingLoad.CargoWidth;
            _model.CargoHeight = ExistingLoad.CargoHeight;
            _model.CargoLength = ExistingLoad.CargoLength;
            _model.DispatcherId = ExistingLoad.DispatcherId;
            _model.LoadStatus = ExistingLoad.LoadStatus;
            
            foreach (var stop in ExistingLoad.LoadStops.OrderBy(s => s.Timestamp))
            {
                var local = stop.Timestamp.ToLocalTime();
                _model.LoadStops.Add(new LoadStopDto {
                    Address = stop.Address,
                    LoadLocationType = stop.LoadLocationType,
                    Note = stop.Note,
                    Location = new Core.Types.GeoPoint { Latitude = stop.Location.Latitude, Longitude = stop.Location.Longitude }
                });
                _stopDates.Add(local.Date);
                _stopTimes.Add(local.TimeOfDay);
            }
        }
        else
        {
            AddStop(LoadLocationType.Pickup);
            AddStop(LoadLocationType.Delivery);
            
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (Guid.TryParse(userId, out var guid)) _model.DispatcherId = guid;
        }
    }

    private void AddStop() => AddStop(LoadLocationType.Delivery);
    
    private void AddStop(LoadLocationType type)
    {
        _model.LoadStops.Add(new LoadStopDto 
        { 
            LoadLocationType = type, 
            Location = new Core.Types.GeoPoint { Latitude = 0, Longitude = 0 },
            Timestamp = DateTime.UtcNow,
            Note = string.Empty
        });
        _stopDates.Add(DateTime.Today);
        _stopTimes.Add(DateTime.Now.TimeOfDay);
    }

    private void RemoveStop(int index)
    {
        if (_model.LoadStops.Count > 2)
        {
            var el = _model.LoadStops.ElementAt(index);
            _model.LoadStops.Remove(el);
            _stopDates.RemoveAt(index);
            _stopTimes.RemoveAt(index);
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        for (int i = 0; i < _model.LoadStops.Count; i++)
        {
            if (_stopDates[i].HasValue && _stopTimes[i].HasValue)
            {
                var combined = _stopDates[i]!.Value.Add(_stopTimes[i]!.Value);
                _model.LoadStops.ElementAt(i).Timestamp = combined.ToUniversalTime();
            }
        }

        _submitting = true;
        try
        {
            if (IsEditMode)
            {
                var result = await LoadsService.UpdateAsync(_model);
                if (result != null)
                {
                    Snackbar.Add("Load updated", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(result.Id));
                }
            }
            else
            {
                var id = await LoadsService.CreateAsync(_model);
                if (id != null)
                {
                    Snackbar.Add("Load created", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(id));
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}