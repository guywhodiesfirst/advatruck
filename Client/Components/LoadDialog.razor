@using Core.Models
@using Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuctionLotApiService AuctionService
@inject LoadApiService LoadService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(IsEditMode ? "Edit Auction" : "Create Auction")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudGrid>
                <MudItem xs="12">
                    @if (IsEditMode)
                    {
                        @* В режимі редагування зазвичай вантаж змінювати не можна, просто показуємо його *@
                        <MudTextField Value="@(_model.LoadId.ToString())" Label="Load ID" ReadOnly="true" Variant="Variant.Outlined" />
                    }
                    else
                    {
                        <MudSelect T="Guid" 
                                   Label="Select Active Load" 
                                   @bind-Value="_model.LoadId" 
                                   Required="true" 
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            @if (_availableLoads == null)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            }
                            else if (!_availableLoads.Any())
                            {
                                <MudSelectItem Value="Guid.Empty" Disabled="true">No available loads found</MudSelectItem>
                            }
                            else
                            {
                                @foreach (var load in _availableLoads)
                                {
                                    <MudSelectItem Value="@load.Id">
                                        <div class="d-flex flex-column">
                                            <MudText Typo="Typo.body1">@load.LoadStops.FirstOrDefault()?.Address</MudText>
                                            <MudText Typo="Typo.body1">@load.LoadStops.Last().Address</MudText>
                                            <MudText Typo="Typo.caption" Style="opacity: 0.7">
                                                Weight: @load.CargoWeight kg | Rate: ₴@load.Rate
                                            </MudText>
                                        </div>
                                    </MudSelectItem>
                                }
                            }
                        </MudSelect>
                    }
                </MudItem>

                @* ... Решта полів (дати та нотатки) залишаються такими ж ... *@
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Start Date" @bind-Date="_startDate" Required="true" MinDate="DateTime.Today" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="Start Time" @bind-Time="_startTime" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="End Date" @bind-Date="_endDate" Required="true" MinDate="_startDate" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker Label="End Time" @bind-Time="_endTime" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Note" @bind-Value="_model.Note" Lines="2" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(_submitting || (_model.LoadId == Guid.Empty && !IsEditMode))">
            @if (_submitting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            @(IsEditMode ? "Save Changes" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public AuctionLotDto? ExistingLot { get; set; }
    [Parameter] public LoadDto? ExistingLoad { get; set; }

    private bool IsEditMode => ExistingLot is not null;
    private MudForm _form = null!;
    private bool _isValid;
    private bool _submitting;
    private List<LoadDto>? _availableLoads;

    private AuctionLotCreateUpdateDto _model = new();
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableLoads();

        if (IsEditMode && ExistingLot is not null)
        {
            _model.Id = ExistingLot.Id;
            _model.LoadId = ExistingLot.LoadId;
            _model.DispatcherCreatedId = ExistingLot.DispatcherCreatedId;
            _model.Note = ExistingLot.Note;

            var localStart = ExistingLot.StartsAt.ToLocalTime();
            _startDate = localStart.Date;
            _startTime = localStart.TimeOfDay;

            var localEnd = ExistingLot.EndsAt.ToLocalTime();
            _endDate = localEnd.Date;
            _endTime = localEnd.TimeOfDay;
        }
        else
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim is not null && Guid.TryParse(userIdClaim.Value, out var uid))
                _model.DispatcherCreatedId = uid;

            _startDate = DateTime.Today;
            _startTime = DateTime.Now.TimeOfDay;
            // Дефолтний час закінчення - через 24 години
            _endDate = DateTime.Today.AddDays(1);
            _endTime = DateTime.Now.TimeOfDay;
        }
    }

    private async Task LoadAvailableLoads()
    {
        try
        {
            // Отримуємо всі вантажі
            var allLoads = await LoadService.GetAllAsync();
            // Фільтруємо ті, що в статусі Scheduled (не призначені водію і не в дорозі)
            // Також можна додати перевірку, чи вже не створено аукціон для цього вантажу
            _availableLoads = allLoads
                .Where(l => l.LoadStatus == Core.Enums.LoadStatus.Scheduled)
                .ToList();
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to load available loads", Severity.Error);
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        if (_startDate == null || _startTime == null || _endDate == null || _endTime == null) return;

        var finalStartsAt = _startDate.Value.Add(_startTime.Value);
        var finalEndsAt = _endDate.Value.Add(_endTime.Value);

        if (finalEndsAt <= finalStartsAt)
        {
            Snackbar.Add("End time must be after start time", Severity.Warning);
            return;
        }

        _model.StartsAt = finalStartsAt.ToUniversalTime();
        _model.EndsAt = finalEndsAt.ToUniversalTime();

        _submitting = true;
        try
        {
            if (IsEditMode)
            {
                var updated = await AuctionService.UpdateAsync(_model);
                MudDialog.Close(DialogResult.Ok(updated));
            }
            else
            {
                var id = await AuctionService.CreateAsync(_model);
                MudDialog.Close(DialogResult.Ok(id));
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error during submission", Severity.Error);
        }
        finally { _submitting = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}