@page "/auctions"
@using Core.Models
@using Core.Enums
@using Client.Services
@using Client.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject AuctionLotApiService AuctionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Auctions</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pt-16">
    <div class="d-flex align-center mb-6">
        <div>
            <MudText Typo="Typo.h4">@(_showAllHistory ? "Auction History" : "Active Auctions")</MudText>
            @if (_showAllHistory)
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Error">Admin View: Full System Archive</MudText>
            }
        </div>
        
        <MudSpacer />

        <div class="d-flex align-center ga-2">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="d-flex align-center border mud-border-lines-default rounded-pill px-3 py-1 mr-4">
                        <MudText Typo="Typo.caption" Class="mr-2">Show History</MudText>
                        <MudSwitch T="bool" 
                                   Value="_showAllHistory" 
                                   ValueChanged="OnHistoryToggled" 
                                   Color="Color.Info" />
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Dispatcher">
                <Authorized>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => OpenAuctionDialog(null))">
                        New Auction
                    </MudButton>
                </Authorized>
            </AuthorizeView>

            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Color="Color.Primary" />
        </div>
    </div>

    @if (_loading)
    {
        <div class="d-flex justify-center mt-10">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (!_lots.Any())
    {
        <MudPaper Class="pa-12 d-flex flex-column align-center justify-center" Elevation="0" Style="min-height: 400px; background: none;">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Default" Class="mb-4" Style="font-size: 80px; opacity: 0.2;" />
            <MudText Typo="Typo.h5" Class="mb-2" Style="opacity: 0.5;">No auctions found</MudText>
            <AuthorizeView Roles="Dispatcher">
                <Authorized>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-4" OnClick="@(() => OpenAuctionDialog(null))">
                        Create First Auction
                    </MudButton>
                </Authorized>
            </AuthorizeView>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var lot in _lots)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="3" Class="pa-2 h-100 d-flex flex-column" Style="border-radius: 12px;">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <div class="d-flex justify-space-between align-start">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.h6" Style="font-weight: bold;">
                                            Lot #@lot.Id.ToString().Substring(0, 8)
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="opacity: 0.6;">Dispatcher: @lot.DispatcherName</MudText>
                                    </div>
                                    <MudChip T="string" 
                                             Color="@(lot.Status == AuctionStatus.Active ? Color.Info : Color.Default)" 
                                             Size="Size.Small" 
                                             Variant="Variant.Filled">
                                        @lot.Status
                                    </MudChip>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        
                        <MudCardContent Class="flex-grow-1 pt-0">
                            <MudText Typo="Typo.caption" Style="text-transform: uppercase; letter-spacing: 1px;">Current Best Rate</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4" Style="font-weight: 700;">
                                @(lot.Bids.Any() ? $"₴{lot.Bids.Min(x => x.Rate)}" : "No bids yet")
                            </MudText>
                            
                            <MudDivider Class="mb-4" />
                            
                            <div class="d-flex justify-space-between align-center">
                                <div class="d-flex align-center">
                                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="mr-1" Style="opacity: 0.5;"/>
                                    <MudText Typo="Typo.body2">@lot.EndsAt.ToLocalTime().ToString("dd MMM, HH:mm")</MudText>
                                </div>
                                <MudText Typo="Typo.body2"><b>@lot.Bids.Count</b> bids</MudText>
                            </div>
                        </MudCardContent>
                        
                        <MudCardActions Class="pb-4 px-4">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       Size="Size.Small"
                                       OnClick="@(() => NavManager.NavigateTo($"/auctions/{lot.Id}"))">
                                Details
                            </MudButton>
                            
                            <MudSpacer />

                            <AuthorizeView Roles="Dispatcher">
                                <Authorized>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                   Size="Size.Small" 
                                                   OnClick="@(() => OpenAuctionDialog(lot))" />
                                    
                                    <MudIconButton Icon="@(lot.Status == AuctionStatus.Active ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)" 
                                                   Color="@(lot.Status == AuctionStatus.Active ? Color.Error : Color.Success)" 
                                                   Size="Size.Small" 
                                                   OnClick="@(() => HandleStatusChange(lot.Id, lot.Status == AuctionStatus.Active ? AuctionStatus.Finished : AuctionStatus.Active))" />
                                </Authorized>
                            </AuthorizeView>

                            @* Ставки ТІЛЬКИ для Водія *@
                            <AuthorizeView Roles="Driver">
                                <Authorized>
                                    <MudButton Variant="Variant.Filled" 
                                               Color="Color.Primary"
                                               Disabled="@(lot.Status == AuctionStatus.Finished)"
                                               OnClick="@(() => OpenBidDialog(lot))">
                                        Bid
                                    </MudButton>
                                </Authorized>
                            </AuthorizeView>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<AuctionLotDto> _lots = new();
    private bool _loading = true;
    private bool _showAllHistory;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task OnHistoryToggled(bool value)
    {
        _showAllHistory = value;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            _lots = _showAllHistory 
                ? await AuctionService.GetAllAsync() 
                : await AuctionService.GetAllActiveAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading auctions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleStatusChange(Guid id, AuctionStatus newStatus)
    {
        var action = newStatus == AuctionStatus.Finished ? "finish" : "re-activate";
        bool? confirm = await DialogService.ShowMessageBoxAsync("Confirm", $"Are you sure you want to {action} this auction?", "Yes", "No");
        
        if (confirm == true)
        {
            try
            {
                var dto = new AuctionLotStatusUpdateDto { Status = newStatus };
                await AuctionService.UpdateStatusAsync(id, dto);
                Snackbar.Add($"Auction is now {newStatus}", Severity.Success);
                await RefreshAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to update status: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenBidDialog(AuctionLotDto lot)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
                          ?? authState.User.FindFirst("sub")?.Value;

        if (!Guid.TryParse(userIdClaim, out var currentUserId)) return;

        var myExistingBid = lot.Bids.FirstOrDefault(x => x.DriverCreatedId == currentUserId);

        var parameters = new DialogParameters<BidDialog> 
        { 
            { x => x.AuctionLotId, lot.Id },
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<BidDialog>(myExistingBid == null ? "Place Bid" : "Update Bid", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false }) await RefreshAsync();
    }

    private async Task OpenAuctionDialog(AuctionLotDto? existing)
    {
        var parameters = new DialogParameters<AuctionLotDialog> { { x => x.ExistingLot, existing } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AuctionLotDialog>(existing == null ? "Create Auction" : "Edit Auction", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false }) await RefreshAsync();
    }
}